    {
      "类型": "method",
      "名称": "onOpenResource",
      "返回值": "void",
      "所属模块": "未知模块",
      "功能描述": "Callback to be called to open the resource handle before crypto operations. NOTE: the handle returned must be closed by onCloseResource. the properties of the operation. HuksCryptoExtensionResult.resultCode may have the following values: 0 - The operation is successful 34800000 - An error occurred in the crypto extension. Possible causes: 1. The input parameter is invalid. 2. The crypto extension encountered an unresolvable error state. 34800001 - The UKey does not exist. Possible causes: 1. The UKey has been removed. 2. The crypto extension maintained an error UKey state. 34800002 - The UKey driver error. This means an unknown error has occurred in the UKey driver. 34800004 - The resourceId does not exist. This indicates that the resourceId has an incorrect device name, application name, or container name.",
      "注释信息": [
        "@param { string } resourceId - resourceId indicates the resource id of the provider.",
        "@param { Array<huksExternalCrypto.HuksExternalCryptoParam> } params - params indicates",
        "@returns { Promise<HuksCryptoExtensionResult> } the promise returned by the function.",
        "@syscap SystemCapability.Security.Huks.CryptoExtension",
        "@since 22"
      ],
      "层级": 1,
      "上级": "CryptoExtensionAbility",
      "since_version": "22",
      "system_capability": "SystemCapability.Security.Huks.CryptoExtension",
      "parameters": [
        {
          "名称": "resourceId",
          "类型": "string",
          "必填": true,
          "说明": "resourceId indicates the resource id of the provider."
        },
        {
          "名称": "params",
          "类型": "Array<huksExternalCrypto.HuksExternalCryptoParam>",
          "必填": true,
          "说明": "params indicates"
        }
      ],
      "return_description": "the promise returned by the function.",
