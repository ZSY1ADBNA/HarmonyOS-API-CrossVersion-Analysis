    {
      "类型": "method",
      "名称": "getProfileConnectionState",
      "返回值": "ProfileConnectionState",
      "所属模块": "未知模块",
      "功能描述": "Get the profile connection state of the current device. With profileId, returns the current connection state of this profile, {@link ProfileConnectionState}. Without profileId, if any profile is connected, {@link ProfileConnectionState#STATE_CONNECTED} is returned. Otherwise, {@link ProfileConnectionState#STATE_DISCONNECTED} is returned.",
      "注释信息": [
        "@permission ohos.permission.ACCESS_BLUETOOTH",
        "@param { ProfileId } [profileId] - Indicate the profile id. This is an optional parameter.",
        "@returns { ProfileConnectionState } Returns the connection state.",
        "@throws { BusinessError } 201 - Permission denied.",
        "@throws { BusinessError } 401 - Invalid parameter. Possible causes: 1. Incorrect parameter types.",
        "@throws { BusinessError } 801 - Capability not supported.",
        "@throws { BusinessError } 2900001 - Service stopped.",
        "@throws { BusinessError } 2900003 - Bluetooth disabled.",
        "@throws { BusinessError } 2900004 - Profile not supported.",
        "@throws { BusinessError } 2900099 - Operation failed.",
        "@syscap SystemCapability.Communication.Bluetooth.Core",
        "@crossplatform",
        "@since 13 dynamic",
        "@since 23 static"
      ],
      "层级": 1,
      "上级": "connection",
      "since_version": "13 dynamic",
      "system_capability": "SystemCapability.Communication.Bluetooth.Core",
      "parameters": [
        {
          "名称": "{",
          "类型": "any",
          "必填": true,
          "说明": "ProfileId } [profileId] - Indicate the profile id. This is an optional parameter."
        }
      ],
      "return_description": "Returns the connection state.",
      "error_codes": [
        {
          "code": "201",
          "description": "Permission denied."
        },
        {
          "code": "401",
          "description": "Invalid parameter. Possible causes: 1. Incorrect parameter types."
        },
        {
          "code": "801",
          "description": "Capability not supported."
        },
        {
          "code": "2900001",
          "description": "Service stopped."
        },
        {
          "code": "2900003",
          "description": "Bluetooth disabled."
        },
        {
          "code": "2900004",
          "description": "Profile not supported."
        },
        {
          "code": "2900099",
          "description": "Operation failed."
        }
